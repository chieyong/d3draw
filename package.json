{
  "name": "d3draw-happiness-garden",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "esbuild tools/preview.jsx --bundle --platform=node --format=esm --jsx=automatic --external:react --external:react-dom --external:d3 --outfile=node_modules/.preview.mjs --log-level=error && node node_modules/.preview.mjs",
    "bake": "node tools/bake.mjs",
    "bundle": "node tools/bundle.mjs",
    "test": "vitest run",
    "smoke": "vite build --logLevel error && bash tools/smoke.sh"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "vite": "^6.0.7",
    "vitest": "^5.0.0"
  }
}
